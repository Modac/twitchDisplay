// Copy this file to include/secrets.h and fill in your values.
// include/secrets.h is gitignored.

#define WIFI_PW      "your-wifi-password"

// Login for the web interface (user "admin") and password for ArduinoOTA
// uploads from PlatformIO (see README).
#define WEB_PASSWORD "choose-a-password"

// Twitch credentials: define TWITCH_TOKEN, TWITCH_CLIENT_SECRET or both.
//
// Option 1: a fixed access token. When it expires the status dot in the
// bottom right corner turns magenta and the display stops updating until you
// flash a new token.
#define TWITCH_TOKEN "your-twitch-access-token"
//
// Option 2 (recommended): the client secret of your Twitch application
// (dev.twitch.tv/console). The display then gets its own app access token
// and renews it automatically. TWITCH_CLIENT_ID must be the matching
// application's client ID (a built-in default is used if it is not set).
//#define TWITCH_CLIENT_ID     "your-client-id"
//#define TWITCH_CLIENT_SECRET "your-client-secret"
