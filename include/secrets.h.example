// OPTIONAL: default settings built into the firmware.
//
// The display stores its settings itself (web interface -> Settings, or the
// setup hotspot on first start). This file is only needed if you want a
// firmware that starts with your settings already filled in. Values that were
// saved on the display always take precedence.
//
// To use it, copy this file to include/secrets.h (gitignored) and remove the
// lines you don't need. Never publish a firmware built with this file.

#define WIFI_SSID    "your-wifi-name"
#define WIFI_PW      "your-wifi-password"

// Login for the web interface (user "admin") and password for ArduinoOTA
// uploads from PlatformIO (see README).
#define WEB_PASSWORD "choose-a-password"

// Twitch application from dev.twitch.tv/console: the display gets and renews
// its own app access token.
#define TWITCH_CLIENT_ID     "your-client-id"
#define TWITCH_CLIENT_SECRET "your-client-secret"

// Alternative to the client secret: a fixed access token (expires, is not
// renewed).
//#define TWITCH_TOKEN "your-twitch-access-token"
